# sandbox | dev | production  (reads URLs from testdata/environments.json)
ENV=sandbox

# Which account from testdata/users.json (optional; default is users.json activeUser)
ACTIVE_USER=brandDefault

# Optional overrides — leave empty to use testdata JSON
WEB_BASE_URL=
API_BASE_URL=

# Passwords only here (never commit .env)
BRAND_PASSWORD=
CREATOR_PASSWORD=

# Password used for every account the registration data factory generates
GENERATED_ACCOUNT_PASSWORD=
